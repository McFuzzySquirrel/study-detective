{
  "name": "notes-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn your notes into a detective story.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "media": "npm run build && node scripts/capture-media.mjs",
    "validate:workflows": "node scripts/validate-workflows.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.4",
    "react-router": "7.18.4",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true
  },
  "allowScripts": {
    "tesseract.js@7.0.0": true
  }
}
