[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       } else if (typeof media.removeListener === 'function') {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         media.removeListener(onChange);
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       }
