    id: uuidSchema,
    cardId: uuidSchema,
    kind: z.enum(ATTACHMENT_KINDS),
    mime: z.enum(ATTACHMENT_MIME_TYPES),
    width: z.number().int().positive(),
    height: z.number().int().positive(),
    bytes: z.number().int().nonnegative(),
