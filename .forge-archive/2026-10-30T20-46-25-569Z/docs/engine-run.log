const agentDir = join(harness, "agents");
const skillDir = join(harness, "skills");

const files = [
  ...(skillsOnly ? [] : walk(agentDir).filter((f) => f.endsWith(".md") && !f.endsWith("SKILL.md")).map((file) => ({ file, kind: "agent" }))),
