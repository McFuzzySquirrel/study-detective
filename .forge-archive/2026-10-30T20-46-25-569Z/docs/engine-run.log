[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z function compareTypes(first: ConnectionType, second: ConnectionType): number {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z   return TYPE_PREFERENCE[first] - TYPE_PREFERENCE[second];
