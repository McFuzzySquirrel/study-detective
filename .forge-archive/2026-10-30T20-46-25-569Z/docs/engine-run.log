[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   const mediaQueries: MediaQueryList[] = [];
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (typeof window.matchMedia === 'function') {
