[engine] harness activity stderr task=FND-2 attempt=1 at=2026-10-25T18:49:45.524Z   features/     shelf, capture, cards, case, connections, closure, recall, search,
[engine] harness activity stderr task=FND-2 attempt=1 at=2026-10-25T18:49:45.524Z                 backup, ocr, demo, onboarding, settings
[engine] harness activity stderr task=FND-2 attempt=1 at=2026-10-25T18:49:45.524Z   styles/       tokens.css, base.css, responsive.css
[engine] harness activity stderr task=FND-2 attempt=1 at=2026-10-25T18:49:45.524Z   pwa.ts        service-worker registration and update flow
