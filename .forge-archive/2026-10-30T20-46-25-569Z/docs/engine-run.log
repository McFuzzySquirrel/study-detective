[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z     toCardId: to,
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z     type,
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z   };
