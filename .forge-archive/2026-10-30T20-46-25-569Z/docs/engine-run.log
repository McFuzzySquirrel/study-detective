[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z export interface RecallTypeMismatch extends RecallPair {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly expectedType: ConnectionType;
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly actualType: ConnectionType;
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z }
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z export interface RecallComparison {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly remembered: readonly RecallPair[];
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly missed: readonly RecallPair[];
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly extra: readonly RecallPair[];
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly typeMismatch: readonly RecallTypeMismatch[];
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z }
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z /**
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z  * A deterministic type preference for duplicate inputs. A real case has one
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z  * string per pair, but a stale snapshot may briefly contain two. Choosing by
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z  * this fixed order keeps the result independent of input order.
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z  */
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z const TYPE_PREFERENCE: Readonly<Record<ConnectionType, number>> = Object.freeze({
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   association: 0,
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   provenance: 1,
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z });
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z interface CanonicalBucket {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly pair: RecallPair;
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   readonly types: readonly ConnectionType[];
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z }
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z function isConnectionType(value: unknown): value is ConnectionType {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   return typeof value === 'string' && (CONNECTION_TYPES as readonly string[]).includes(value);
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z }
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z function isEndpoint(value: unknown): value is string {
