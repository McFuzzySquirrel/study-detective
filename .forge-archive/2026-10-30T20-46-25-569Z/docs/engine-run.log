[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         } else if (typeof media.addListener === 'function') {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z           media.addListener(onChange);
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         mediaQueries.push(media);
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       } catch {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         // Ignore one broken query; the resize listener still keeps the mode
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         // current.
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   window.addEventListener('resize', onChange);
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   return () => {
