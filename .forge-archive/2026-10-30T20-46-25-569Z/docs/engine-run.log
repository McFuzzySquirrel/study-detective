[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z /**
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * The three layout modes the app designs for.
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  *
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * CSS owns the visual breakpoints, but a few surfaces need to change their
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * *semantics* rather than only their style: a side panel on tablet becomes a
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * modal bottom sheet on a phone, so it must not be rendered twice. This hook is
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * the single JavaScript answer to "which layout is the browser in?", matching
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * the documented breakpoints:
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  *
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.422Z  * - phone: below 600 px
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  * - tablet: 600–1199 px
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  * - desktop: 1200 px and up
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  *
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  * The hook uses `matchMedia` when available and falls back to `innerWidth`, so
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  * jsdom tests and a browser without matchMedia still resolve a sensible mode.
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z  */
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z import { useSyncExternalStore } from 'react';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z /** Below 600 px: `37.4375rem === 599px`, so 600 itself belongs to tablet. */
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z export const PHONE_MAX_QUERY = '(max-width: 37.4375rem)';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z /** Below 1200 px: `74.9375rem === 1199px`, so 1200 itself belongs to desktop. */
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z export const TABLET_MAX_QUERY = '(max-width: 74.9375rem)';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z export const PHONE_MAX_WIDTH = 600;
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z export const DESKTOP_MIN_WIDTH = 1200;
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z export type LayoutMode = 'phone' | 'tablet' | 'desktop';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z function readLayoutMode(): LayoutMode {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (typeof window === 'undefined') {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     return 'desktop';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (typeof window.matchMedia === 'function') {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     try {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       if (window.matchMedia(PHONE_MAX_QUERY).matches) {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         return 'phone';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       if (window.matchMedia(TABLET_MAX_QUERY).matches) {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z         return 'tablet';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       return 'desktop';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     } catch {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       // A broken matchMedia implementation must not blank the app; fall back
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z       // to the width-based answer below.
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (window.innerWidth < PHONE_MAX_WIDTH) {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     return 'phone';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (window.innerWidth < DESKTOP_MIN_WIDTH) {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z     return 'tablet';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   return 'desktop';
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z }
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z function subscribe(onChange: () => void): () => void {
[engine] harness activity stderr task=A11Y-2 attempt=1 at=2026-10-26T18:54:01.423Z   if (typeof window === 'undefined') {
