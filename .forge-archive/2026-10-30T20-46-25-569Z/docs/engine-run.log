[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z     const existing = buckets.get(pair.pairKey);
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z     if (existing === undefined) {
