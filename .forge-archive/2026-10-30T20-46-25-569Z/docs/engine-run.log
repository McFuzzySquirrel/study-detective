[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z function orderEndpoints(
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.450Z   cardIdA: string,
