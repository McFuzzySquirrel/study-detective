[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z export function canonicalizeConnection(connection: ComparableConnection): RecallPair | null {
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z   const { fromCardId, toCardId, type } = connection;
[engine] harness activity stderr task=RECALL-3 attempt=1 at=2026-10-26T17:38:46.451Z   if (!isEndpoint(fromCardId) || !isEndpoint(toCardId) || fromCardId === toCardId) {
