export type ArchiveAttachmentMetadataInput = {
  readonly id: string;
  readonly cardId: string;
  readonly kind: AttachmentKind;
  readonly mime: AttachmentMime;
  readonly width: number;
  readonly height: number;
  readonly bytes: number;
