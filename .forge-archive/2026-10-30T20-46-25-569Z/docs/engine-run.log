[engine] harness activity stderr task=BOARD-1 attempt=1 at=2026-10-25T21:35:43.567Z export const INITIAL_CARD_STAGGER_PX = 16;
[engine] harness activity stderr task=BOARD-1 attempt=1 at=2026-10-25T21:35:43.567Z /** Repeat the stagger after this many cards so it never drifts far away. */
